# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Requires Node.js 24 LTS (see .nvmrc).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or the legacy "service_role" key. SERVER ONLY — never expose to the browser.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_NAME="Marine Institute DMS"
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Public verification portal (/verify)
# Absolute site URL used in QR codes and slips, e.g. https://dms.example.edu (falls back to the request host).
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Leave empty in development to use
# Cloudflare's always-pass test keys; both are required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random secret used to hash requester IP addresses in the verification log (e.g. `openssl rand -hex 32`).
VERIFY_IP_SALT=
